{
  "manifest_version": 3,
  "name": "Steam Gauge",
  "version": "1.0",
  "description": "Affiche l'historique des prix (Steam/Instant Gaming) et les stats HowLongToBeat directement sur le magasin Steam.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://hltbapi1.azurewebsites.net/*",
    "https://www.instant-gaming.com/*",
    "https://api.isthereanydeal.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
